DATABASE_URL=postgresql://irenee_runtime:change-me@127.0.0.1:5432/irenee
LOCAL_AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
# Keep these independent from the JWT secret so each key can rotate separately.
RATE_LIMIT_PEPPER=replace-with-at-least-32-random-characters
AUDIT_LOG_PEPPER=replace-with-at-least-32-random-characters
# Generate an independent 32-byte key with: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
# Production always forces Secure cookies even if this value is accidentally changed.
AUTH_COOKIE_SECURE=true
AVATAR_STORAGE_DIR=/var/lib/irenee/avatars
# Only used to display historical Cloudinary-hosted images; no upload preset is exposed client-side.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=da52mpv3g
STRIPE_API_VERSION=2022-11-15
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_LITE_SECRET=
