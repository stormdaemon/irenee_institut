[Unit]
Description=Verified daily PostgreSQL backup for Institut Irenee
After=postgresql.service

[Service]
Type=oneshot
ExecStart=/bin/bash /srv/irenee-current/scripts/backup-database.sh
User=root
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/irenee
